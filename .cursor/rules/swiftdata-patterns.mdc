# SwiftData Patterns for Closet

## Model Relationships

### One-to-Many Relationships
```swift
// Category has many Items
@Model
final class Category {
    var name: String
    
    @Relationship(deleteRule: .cascade, inverse: \Item.category)
    var items: [Item] = []
}

@Model  
final class Item {
    var name: String
    var category: Category?
}
```

### Many-to-Many Relationships
```swift
// Items can have multiple Tags, Tags can be on multiple Items
@Model
final class Item {
    var name: String
    
    @Relationship(deleteRule: .nullify, inverse: \Tag.items)
    var tags: [Tag] = []
}

@Model
final class Tag {
    var name: String
    var items: [Item] = []
}
```

## Query Patterns

### Basic Queries
```swift
// All items sorted by name
@Query(sort: \Item.name) private var items: [Item]

// Items sorted by multiple criteria
@Query(sort: [
    SortDescriptor(\Item.category?.name),
    SortDescriptor(\Item.name)
]) private var items: [Item]
```

### Filtered Queries
```swift
// Items with quantity > 0
@Query(filter: #Predicate<Item> { $0.quantity > 0 }) 
private var inStockItems: [Item]

// Items in a specific category (use computed property for dynamic filtering)
@Query private var allItems: [Item]

func items(in category: Category) -> [Item] {
    allItems.filter { $0.category == category }
}
```

### Dynamic Queries with @Query(filter:)
```swift
struct ItemListView: View {
    let category: Category
    @Query private var items: [Item]
    
    init(category: Category) {
        self.category = category
        let categoryName = category.name
        _items = Query(
            filter: #Predicate<Item> { item in
                item.category?.name == categoryName
            },
            sort: \Item.name
        )
    }
}
```

## CRUD Operations

### Creating Items
```swift
func addItem(name: String, category: Category?) {
    let item = Item(name: name)
    item.category = category
    modelContext.insert(item)
    // SwiftData auto-saves, but you can force save:
    // try? modelContext.save()
}
```

### Updating Items
```swift
func updateItem(_ item: Item, name: String, quantity: Int) {
    item.name = name
    item.quantity = quantity
    item.lastModified = Date()
    // Changes are automatically tracked and saved
}
```

### Deleting Items
```swift
func deleteItem(_ item: Item) {
    modelContext.delete(item)
}

func deleteItems(at offsets: IndexSet, from items: [Item]) {
    for index in offsets {
        modelContext.delete(items[index])
    }
}
```

## Testing with SwiftData

```swift
// Create an in-memory container for testing
func createTestContainer() throws -> ModelContainer {
    let config = ModelConfiguration(isStoredInMemoryOnly: true)
    return try ModelContainer(
        for: Item.self, Category.self, Tag.self,
        configurations: config
    )
}

// In tests
func testItemCreation() throws {
    let container = try createTestContainer()
    let context = container.mainContext
    
    let item = Item(name: "Test Item")
    context.insert(item)
    
    let descriptor = FetchDescriptor<Item>()
    let items = try context.fetch(descriptor)
    
    XCTAssertEqual(items.count, 1)
    XCTAssertEqual(items.first?.name, "Test Item")
}
```

## Common Gotchas

1. **Don't use `description` as a property name** - conflicts with Swift protocols
2. **Relationships must be optional or have default values**
3. **Use `@Transient` for computed/non-persisted properties**
4. **Model classes must be `final`**
5. **Only class types can be @Model (not structs)**
